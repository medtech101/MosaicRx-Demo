# Copy this file to .env for local development.
# On Replit, set these as Replit Secrets instead (Tools -> Secrets) -
# they are injected as environment variables automatically and this file
# is not needed there.

# LLM used for summarization / flashcard generation. Never hardcode this key.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Optional: commercial study platform API access. Leave blank for link-only mode.
AMBOSS_API_KEY=
BNB_API_KEY=
BOOTCAMP_API_KEY=

# Optional: NCBI E-utilities. An email + key raise the anonymous rate limit.
NCBI_API_KEY=
NCBI_EMAIL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECRET=change-me-in-production
